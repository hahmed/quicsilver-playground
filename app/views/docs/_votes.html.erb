<div class="rounded-3xl border border-white/10 bg-black/20 p-4">
  <p class="text-xs font-bold uppercase tracking-[0.18em] text-slate-500">Was this useful?</p>
  <div class="mt-4 flex flex-wrap items-center gap-2">
    <%= button_to "Helpful", doc_vote_path(doc_page, direction: "up"), method: :post, class: "rounded-full bg-emerald-400 px-4 py-2 text-xs font-black text-slate-950 transition hover:bg-emerald-300" %>
    <%= button_to "Needs work", doc_vote_path(doc_page, direction: "down"), method: :post, class: "rounded-full border border-white/10 bg-white/[0.05] px-4 py-2 text-xs font-bold text-white transition hover:bg-white/[0.09]" %>
    <span class="ml-auto rounded-full bg-cyan-400/10 px-3 py-1 text-xs font-bold text-cyan-300">Score <%= doc_page.score %></span>
  </div>
  <p class="mt-3 text-xs text-slate-500"><%= pluralize(doc_page.upvotes, "upvote") %> · <%= pluralize(doc_page.downvotes, "downvote") %></p>
</div>
