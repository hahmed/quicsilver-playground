<main class="min-h-screen bg-[#070A12] text-white">
  <div class="pointer-events-none fixed inset-0 -z-10 bg-[radial-gradient(circle_at_20%_0%,rgba(34,211,238,0.22),transparent_30%),radial-gradient(circle_at_80%_10%,rgba(129,140,248,0.18),transparent_28%)]"></div>

  <header class="mx-auto flex w-full max-w-6xl items-center justify-between px-6 py-6 sm:px-8">
    <div class="flex items-center gap-3">
      <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-cyan-400 text-sm font-black text-slate-950">Q</div>
      <div>
        <p class="text-sm font-bold leading-none">Quicsilver</p>
        <p class="mt-1 text-xs text-slate-500">Rails WebTransport playground</p>
      </div>
    </div>

    <div class="rounded-full border border-white/10 bg-white/[0.04] px-3 py-1.5 text-xs font-medium text-slate-300">
      Experimental
    </div>
  </header>

  <section class="mx-auto grid w-full max-w-6xl gap-8 px-6 pb-16 pt-8 sm:px-8 lg:grid-cols-[1.05fr_0.95fr] lg:items-center lg:pb-24 lg:pt-14">
    <div>
      <div class="mb-6 inline-flex rounded-full border border-cyan-300/20 bg-cyan-300/10 px-4 py-2 text-sm font-semibold text-cyan-200">
        HTTP/3 + WebTransport for Rails
      </div>

      <h1 class="max-w-4xl text-balance text-5xl font-black tracking-tight sm:text-6xl lg:text-7xl">
        Browser-native realtime, served by Ruby.
      </h1>

      <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-300">
        Quicsilver Playground is a small Rails app for trying WebTransport streams,
        HTTP/3 discovery, and realtime primitives without leaving Rails.
      </p>

      <div class="mt-8 flex flex-wrap gap-3">
        <button type="button" onclick="runEcho()" class="rounded-full bg-cyan-400 px-5 py-3 text-sm font-black text-slate-950 shadow-lg shadow-cyan-950/50 transition hover:bg-cyan-300">
          Run echo demo
        </button>
        <button type="button" onclick="clearTransportLog()" class="rounded-full border border-white/10 bg-white/[0.05] px-5 py-3 text-sm font-bold text-white transition hover:bg-white/[0.09]">
          Clear output
        </button>
      </div>
    </div>

    <article class="rounded-[2rem] border border-white/10 bg-white/[0.06] p-4 shadow-2xl shadow-black/30 backdrop-blur">
      <div class="mb-4 flex items-center justify-between px-2">
        <div>
          <p class="text-sm font-bold">Echo stream</p>
          <p class="mt-1 text-xs text-slate-500">One bidirectional WebTransport stream</p>
        </div>
        <div class="rounded-full bg-emerald-400/10 px-3 py-1 text-xs font-semibold text-emerald-300">
          <span id="webtransport-status">checking...</span>
        </div>
      </div>

      <pre id="transport-output" class="min-h-72 overflow-auto rounded-3xl border border-white/10 bg-[#02040A] p-5 font-mono text-sm leading-6 text-emerald-300 shadow-inner shadow-black whitespace-pre-wrap">Click “Run echo demo” to start.</pre>
    </article>
  </section>

  <section class="mx-auto grid w-full max-w-6xl gap-4 px-6 pb-16 sm:px-8 md:grid-cols-3">
    <article class="rounded-3xl border border-white/10 bg-white/[0.045] p-6">
      <div class="mb-5 flex h-11 w-11 items-center justify-center rounded-2xl bg-cyan-400/10 text-cyan-300">01</div>
      <h2 class="text-lg font-black">Rails routes</h2>
      <p class="mt-3 text-sm leading-6 text-slate-400">
        Declare WebTransport endpoints beside normal Rails routes.
      </p>
    </article>

    <article class="rounded-3xl border border-white/10 bg-white/[0.045] p-6">
      <div class="mb-5 flex h-11 w-11 items-center justify-center rounded-2xl bg-indigo-400/10 text-indigo-300">02</div>
      <h2 class="text-lg font-black">Reliable streams</h2>
      <p class="mt-3 text-sm leading-6 text-slate-400">
        Send framed JSON messages over browser WebTransport streams.
      </p>
    </article>

    <article class="rounded-3xl border border-white/10 bg-white/[0.045] p-6">
      <div class="mb-5 flex h-11 w-11 items-center justify-center rounded-2xl bg-fuchsia-400/10 text-fuchsia-300">03</div>
      <h2 class="text-lg font-black">HTTP/3 first</h2>
      <p class="mt-3 text-sm leading-6 text-slate-400">
        Exercise QUIC, Alt-Svc, and browser-native realtime locally.
      </p>
    </article>
  </section>
</main>
