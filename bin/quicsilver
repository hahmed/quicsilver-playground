#!/usr/bin/env ruby
# frozen_string_literal: true

$stdout.sync = true
$stderr.sync = true

ENV["RAILS_ENV"] ||= "development"

require_relative "../config/environment"
require "logger"
require "quicsilver"
require "quicsilver/rails/dev_web_transport_certificate"

Quicsilver.logger = Logger.new($stderr).tap do |logger|
  logger.progname = "Quicsilver"
  logger.level = ENV["QUICSILVER_DEBUG"] || ENV["H3_DEBUG"] ? Logger::DEBUG : Logger::INFO
end

host = ENV.fetch("QUICSILVER_HOST", "0.0.0.0")
port = Integer(ENV.fetch("QUICSILVER_PORT", "4433"))
certificate = Quicsilver::Rails::DevWebTransportCertificate.fetch
cert_file = ENV.fetch("WEBTRANSPORT_CERT", certificate.cert_file)
key_file = ENV.fetch("WEBTRANSPORT_KEY", certificate.key_file)

configuration = Quicsilver::Transport::Configuration.new(
  cert_file,
  key_file,
  idle_timeout_ms: 120_000,
  keep_alive_interval_ms: 20_000,
  max_unidirectional_streams: 100
)

puts "=> Booting Quicsilver HTTP/3"
puts "=> Rails #{Rails.version} application starting in #{Rails.env}"
puts "=> Listening on udp://#{host}:#{port}"
puts "=> TLS cert: #{cert_file}"
puts "=> Ctrl-C to shutdown"

app = if ENV["H3_DEBUG"]
  ->(env) do
    puts "[h3] #{env["REQUEST_METHOD"]} #{env["HTTP_HOST"]} #{env["PATH_INFO"]}"
    Rails.application.call(env)
  end
else
  Rails.application
end

server = Quicsilver::Server.new(
  port,
  address: host,
  app: app,
  server_configuration: configuration
)

server.start
